# Environment Variables
# =====================
# Copy this file to .env and fill in your credentials.
# NEVER commit the .env file — it is gitignored.
# NEVER put real credentials in this file.

# ── Rime TTS (required) ───────────────────────────────────────────────────────
RIME_API_KEY=YOUR_RIME_API_KEY_HERE
RIME_API_URL=https://users.rime.ai/v1/rime-tts
RIME_DEFAULT_MODEL=coda
# sol is a placeholder: the recap client resolves the voice automatically —
# eyre (female, English) for `en` recaps and nadi (female Hindi accent) for
# Hinglish (`hi`) recaps.
RIME_DEFAULT_SPEAKER=sol
RIME_DEFAULT_LANGUAGE=en
RIME_TIME_SCALE_FACTOR=0.78

# ── LiveKit (required) ────────────────────────────────────────────────────────
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET
PRIVATE_TRACK_ID=continuum-private-whisper

# ── Telephony / SIP (optional — leave empty for browser-simulated ring) ───────
SIP_TRUNK_ID=

# ── Speech-to-Text (required for real STT; not needed when USE_MOCKS=true) ────
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=YOUR_DEEPGRAM_API_KEY
# The mic transcribes with the Nova-3 Hindi model (language=hi — Deepgram's
# `multi` mode misdetects Hindi as Spanish). Devanagari output is romanized to
# Latin-script Hinglish on the backend, so transcripts look like "hello bhai
# kaise ho".
# DEEPGRAM_MODEL=nova-3-general
# ASSEMBLYAI_API_KEY=YOUR_ASSEMBLYAI_API_KEY  # uncomment if using AssemblyAI

# ── LLM (required for Recap Generator; not needed when USE_MOCKS=true) ────────
LLM_FAST_MODEL=gemini-2.0-flash
LLM_STRONG_MODEL=gemini-2.5-pro
GEMINI_API_KEY=YOUR_GEMINI_API_KEY  # used by the recap generator (ConversationExtractor)
# LLM_API_KEY=YOUR_GEMINI_OR_ANTHROPIC_KEY  # leave empty to use Antigravity model access

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (hackathon default — no setup needed):
DATABASE_URL=sqlite+aiosqlite:///./continuum.db
# Postgres (production — uncomment and fill in):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/continuum

# ── Development / mock flags ──────────────────────────────────────────────────
# Set to true to use /mocks/ implementations instead of real services.
# Highly recommended for local development without external API credentials.
USE_MOCKS=true
MOCK_FRESHNESS_API_URL=http://localhost:8001

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
